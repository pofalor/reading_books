<nav class="navbar">
  <div class="container">
    <a href="/" class="logo">КнижнаяПолка</a>
    <div class="nav-links">
      <a href="/" class="<%= activeLink === 'home' ? 'active' : '' %>">
        <i class="fas fa-home"></i> Главная
      </a>
      <a href="/my-books" class="<%= activeLink === 'my-books' ? 'active' : '' %> auth-only">
        <i class="fas fa-bookmark"></i> Мои книги
      </a>
      <a href="/search" class="<%= activeLink === 'search' ? 'active' : '' %>">
        <i class="fas fa-search"></i> Поиск
      </a>

      <% if (authButtons) { %>
        <div class="auth-buttons guest-only">
          <a href="/auth/login" class="btn outline">
            <i class="fas fa-sign-in-alt"></i> Войти
          </a>
          <a href="/auth/register" class="btn">
            <i class="fas fa-user-plus"></i> Регистрация
          </a>
        </div>
        <% } %>
          <% if (!!user && !!user.roles && user.roles.some(role=> role === 'super_admin' || role === 'admin')) { %>
            <a href="/admin" class="<%= activeLink === 'admin' ? 'active' : '' %>">
              <i class="fas fa-user-shield"></i> Администрирование
            </a>
          <% } %>
          <% if (!!user && !!user.roles && user.roles.some(role=> role === 'moderator')) { %>
            <a href="/moderation" class="<%= activeLink === 'moderation' ? 'active' : '' %>">
              <i class="fas fa-gavel"></i> Модерация
            </a>
          <% } %>
          <% if (!!user && !!user.roles && user.roles.some(role=> role === 'moderator' || role === 'super_admin' || role === 'admin')) { %>
            <a href="/history" class="<%= activeLink === 'history' ? 'active' : '' %>">
              <i class="fas fa-history"></i> Журнал
            </a>
          <% } %>
          <div class="button-no-border" id="back-button">
            <img src="/images/go-back.png" alt="Назад" style="max-width: 30px;">
          </div>
          <div class="user-profile auth-only button-no-border">
            <img src="/images/user-icon.png" alt="Профиль" class="user-avatar" style="max-width: 30px;">
            <span class="user-name"></span>
          </div>
          <button class="logout-link auth-only button-no-border" title="Выйти">
            <img src="/images/logout.png" alt="Выйти" style="max-width: 30px;">
          </button>
    </div>
    <button class="mobile-menu-btn">
      <i class="fas fa-bars"></i>
    </button>
  </div>
</nav>

<script src="/js/navbar.js" type="module"></script>
<script src="/js/shared/navigation-history.js" type="module"></script>