<!DOCTYPE html>
<html lang="ru">

<head>
  <%- include('partials/header', { title: 'Модерация' }) %>
    <link rel="stylesheet" href="/css/moderation.css">
</head>

<body>
  <%- include('partials/navbar', { activeLink: 'moderation' , authButtons: false }) %>

    <div class="page-container">
      <h1>Модерация контента</h1>

      <div class="moderation-tabs">
        <a href="/moderation?tab=books" class="tab <%= activeTab === 'books' ? 'active' : '' %>">
          <i class="fas fa-book"></i> Книги
        </a>
        <a href="/moderation?tab=authors" class="tab <%= activeTab === 'authors' ? 'active' : '' %>">
          <i class="fas fa-user-edit"></i> Авторы
        </a>
        <a href="/moderation?tab=genres" class="tab <%= activeTab === 'genres' ? 'active' : '' %>">
          <i class="fas fa-tags"></i> Жанры
        </a>
      </div>

      <% if (activeTab==='books' ) { %>
        <div class="card">
          <button id="add-book-btn" class="btn primary moderation-add-button">
            <i class="fas fa-plus"></i> Добавить книгу
          </button>

          <h2><i class="fas fa-list"></i> Все книги</h2>
          <div class="search-container">
            <input type="text" id="book-search" placeholder="Поиск по названию, автору или жанру...">
            <button id="search-books-btn" class="btn primary">Поиск</button>
          </div>
          <div id="all-books-container">
            <div id="all-books-table" class="table"></div>
            <div id="no-all-books" class="no-data-message">
              <i class="fas fa-book-open"></i>
              <p>Книги не найдены</p>
            </div>
          </div>
        </div>
        <% } %>
          <% if (activeTab==='authors' ) { %>
            <div class="card">
              <button id="add-author-btn" class="btn primary moderation-add-button">
                <i class="fas fa-user-plus"></i> Добавить автора
              </button>

              <h2><i class="fas fa-list"></i> Все авторы</h2>
              <div class="search-container">
                <input type="text" id="author-search" placeholder="Поиск по имени, фамилии, отчеству, псевдониму...">
                <button id="search-authors-btn" class="btn primary">Поиск</button>
              </div>
              <div id="all-authors-container">
                <div id="all-authors-table" class="table"></div>
                <div id="no-all-authors" class="no-data-message">
                  <i class="fas fa-book-open"></i>
                  <p>Авторы не найдены</p>
                </div>
              </div>
            </div>
            <% } %>
              <% if (activeTab==='genres' ) { %>
                <div class="card">
                  <button id="add-genre-btn" class="btn primary moderation-add-button">
                    <i class="fas fa-plus"></i> Добавить жанр
                  </button>

                  <h2><i class="fas fa-tags"></i> Все жанры</h2>
                  <div class="search-container">
                    <input type="text" id="genre-search" placeholder="Поиск по названию или описанию...">
                    <button id="search-genres-btn" class="btn primary">Поиск</button>
                  </div>

                  <div id="genres-container">
                    <div id="genres-table" class="table"></div>
                    <div id="no-genres" class="no-data-message">
                      <i class="fas fa-tag"></i>
                      <p>Жанры не найдены</p>
                    </div>
                  </div>
                </div>
                <% } %>

    </div>
    <!-- Аналогичные блоки для authors и genres -->
    </div>

    <!-- Модальное окно добавления книги -->
    <div id="add-book-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Добавить книгу</h2>
        <form id="add-book-form" enctype="multipart/form-data">
          <div class="form-group">
            <label for="book-title">Название*</label>
            <input type="text" id="book-title" required>
          </div>

          <div class="form-group">
            <label>Дата публикации</label>
            <div style="display: flex; align-items: baseline; gap: 5px;">
              <input id="pub-day" type="number" placeholder="ДД" min="1" max="31">
              <span>/</span>
              <input id="pub-month" type="number" placeholder="ММ" min="1" max="12">
              <span>/</span>
              <input id="pub-year" type="number" placeholder="ГГГГ" min="1">
            </div>
          </div>

          <div class="form-group">
            <label for="book-description">Описание</label>
            <textarea id="book-description"></textarea>
          </div>

          <div class="form-group">
            <label for="book-file">Файл книги* (epub)</label>
            <div class="file-input-container">
              <button type="button" class="file-input-button">
                <i class="fas fa-upload"></i> Выберите файл
              </button>
              <input type="file" id="book-file" class="file-input" accept=".epub" required>
            </div>
            <div id="file-name" class="file-name">Файл не выбран</div>
          </div>

          <div class="form-group">
            <label for="book-price">Цена</label>
            <input type="number" id="book-price" min="0" step="1">
          </div>

          <div class="form-group">
            <input type="checkbox" id="book-guest-available">
            <label for="book-guest-available">Доступна гостям</label>
          </div>

          <div class="form-group">
            <%- include('partials/dropdown-selector', { id: 'author-select' , containerClass: '' , label: 'Автор' ,
              apiUrl: '/api/authors/search' , displayField: 'nickName' , valueField: 'id' , descriptionField: '' ,
              inputClass: '' , placeholder: 'Начните вводить имя автора...' , selectedDisplay: '' , selectedValue: '' ,
              required: true, method: 'POST' }) %>
              <button type="button" id="add-new-author" class="btn outline">Добавить нового автора</button>
          </div>

          <div class="form-group">
            <%- include('partials/multi-select-dropdown', { id: 'genres-select' , label: 'Жанры' ,
              apiUrl: '/api/genres/getAll' , displayField: 'name' , valueField: 'id' , descriptionField: '' ,
              placeholder: 'Начните вводить название жанра...' , selectedValues: '' , required: true, method: 'POST' })
              %>
              <button type="button" id="add-new-genre" class="btn outline">Добавить новый жанр</button>
          </div>
          <button type="submit" class="btn primary">Добавить книгу</button>
      </div>
      </form>
    </div>

    <!-- Модальное окно добавления автора -->
    <div id="add-author-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2><i class="fas fa-user-plus"></i> Добавить автора</h2>

        <div class="modal-form-container">
          <form id="add-author-form">
            <div class="form-group">
              <label for="author-first-name">Имя</label>
              <input type="text" id="author-first-name">
            </div>

            <div class="form-group">
              <label for="author-second-name">Отчество</label>
              <input type="text" id="author-second-name">
            </div>

            <div class="form-group">
              <label for="author-surname">Фамилия</label>
              <input type="text" id="author-surname">
            </div>

            <div class="form-group">
              <label for="author-nickname">Псевдоним*</label>
              <input type="text" id="author-nickname" required>
            </div>

            <div class="form-group">
              <label for="author-birth-date">Дата рождения</label>
              <input type="date" id="author-birth-date">
            </div>

            <div class="form-group">
              <label for="author-bio">Биография</label>
              <textarea id="author-bio" rows="4"></textarea>
            </div>
          </form>
        </div>

        <div class="form-footer">
          <button type="button" class="btn outline" id="cancel-author-btn">
            <i class="fas fa-times"></i> Отмена
          </button>
          <button type="submit" form="add-author-form" class="btn primary">
            <i class="fas fa-check"></i> Сохранить
          </button>
        </div>
      </div>
    </div>

    <!-- Модальное окно подробной биографии автора -->
    <div id="bio-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Биография автора</h2>
        <div id="bio-content" class="white-space-modal"></div>
      </div>
    </div>

    <div id="description-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Описание книги</h2>
        <div id="description-content" class="white-space-modal"></div>
      </div>
    </div>

    <!-- Модальное окно добавления жанра -->
    <div id="add-genre-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2><i class="fas fa-tag"></i> Добавить жанр</h2>

        <div class="modal-form-container">
          <form id="add-genre-form">
            <div class="form-group">
              <label for="genre-name">Название*</label>
              <input type="text" id="genre-name" required>
            </div>

            <div class="form-group">
              <label for="genre-description">Описание</label>
              <textarea id="genre-description" rows="4"></textarea>
            </div>
          </form>
        </div>

        <div class="form-footer">
          <button type="button" class="btn outline" id="cancel-genre-btn">
            <i class="fas fa-times"></i> Отмена
          </button>
          <button type="submit" form="add-genre-form" class="btn primary">
            <i class="fas fa-check"></i> Сохранить
          </button>
        </div>
      </div>
    </div>

    <!-- Модальное окно редактирования книги -->
    <div id="edit-book-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Редактировать книгу</h2>
        <form id="edit-book-form">
          <div class="form-group">
            <label for="edit-book-title">Название*</label>
            <input type="text" id="edit-book-title" required>
          </div>
        
          <div class="form-group">
            <label>Дата публикации</label>
            <div style="display: flex; align-items: baseline; gap: 5px;">
              <input id="edit-pub-day" type="number" placeholder="ДД" min="1" max="31">
              <span>/</span>
              <input id="edit-pub-month" type="number" placeholder="ММ" min="1" max="12">
              <span>/</span>
              <input id="edit-pub-year" type="number" placeholder="ГГГГ" min="1">
            </div>
          </div>
        
          <div class="form-group">
            <label for="edit-book-description">Описание</label>
            <textarea id="edit-book-description"></textarea>
          </div>
        
          <div class="form-group">
            <label for="edit-book-price">Цена</label>
            <input type="number" id="edit-book-price" min="0" step="1">
          </div>
        
          <div class="form-group">
            <input type="checkbox" id="edit-book-guest-available">
            <label for="edit-book-guest-available">Доступна гостям</label>
          </div>
        
          <div class="form-group">
            <%- include('partials/dropdown-selector', { id: 'edit-author-select' , containerClass: '' , label: 'Автор' ,
              apiUrl: '/api/authors/search' , displayField: 'nickName' , valueField: 'id' , descriptionField: '' ,
              inputClass: '' , placeholder: 'Начните вводить имя автора...' , selectedDisplay: '' , selectedValue: '' ,
              required: true, method: 'POST' }) %>
          </div>
        
          <div class="form-group">
            <%- include('partials/multi-select-dropdown', { id: 'edit-genres-select' , label: 'Жанры' ,
              apiUrl: '/api/genres/getAll' , displayField: 'name' , valueField: 'id' , descriptionField: '' ,
              placeholder: 'Начните вводить название жанра...' , selectedValues: '' , required: true, method: 'POST' }) %>
          </div>
        
          <div class="form-footer">
            <button type="button" class="btn outline" id="cancel-edit-book-btn">
              <i class="fas fa-times"></i> Отмена
            </button>
            <button type="submit" class="btn primary">
              <i class="fas fa-save"></i> Сохранить изменения
            </button>
          </div>
        </form>
      </div>
    </div>
    
    <!-- Модальное окно редактирования автора -->
    <div id="edit-author-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2><i class="fas fa-user-edit"></i> Редактировать автора</h2>
      
        <div class="modal-form-container">
          <form id="edit-author-form">
            <div class="form-group">
              <label for="edit-author-first-name">Имя</label>
              <input type="text" id="edit-author-first-name">
            </div>
          
            <div class="form-group">
              <label for="edit-author-second-name">Отчество</label>
              <input type="text" id="edit-author-second-name">
            </div>
          
            <div class="form-group">
              <label for="edit-author-surname">Фамилия</label>
              <input type="text" id="edit-author-surname">
            </div>
          
            <div class="form-group">
              <label for="edit-author-nickname">Псевдоним*</label>
              <input type="text" id="edit-author-nickname" required>
            </div>
          
            <div class="form-group">
              <label for="edit-author-birth-date">Дата рождения</label>
              <input type="date" id="edit-author-birth-date">
            </div>
          
            <div class="form-group">
              <label for="edit-author-bio">Биография</label>
              <textarea id="edit-author-bio" rows="4"></textarea>
            </div>
          </form>
        </div>
      
        <div class="form-footer">
          <button type="button" class="btn outline" id="cancel-edit-author-btn">
            <i class="fas fa-times"></i> Отмена
          </button>
          <button type="submit" form="edit-author-form" class="btn primary">
            <i class="fas fa-save"></i> Сохранить изменения
          </button>
        </div>
      </div>
    </div>
    
    <!-- Модальное окно редактирования жанра -->
    <div id="edit-genre-modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h2><i class="fas fa-tag"></i> Редактировать жанр</h2>
      
        <div class="modal-form-container">
          <form id="edit-genre-form">
            <div class="form-group">
              <label for="edit-genre-name">Название*</label>
              <input type="text" id="edit-genre-name" required>
            </div>
          
            <div class="form-group">
              <label for="edit-genre-description">Описание</label>
              <textarea id="edit-genre-description" rows="4"></textarea>
            </div>
          </form>
        </div>
      
        <div class="form-footer">
          <button type="button" class="btn outline" id="cancel-edit-genre-btn">
            <i class="fas fa-times"></i> Отмена
          </button>
          <button type="submit" form="edit-genre-form" class="btn primary">
            <i class="fas fa-save"></i> Сохранить изменения
          </button>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %>
      <script src="/js/moderation.js" type="module"></script>
</body>

</html>