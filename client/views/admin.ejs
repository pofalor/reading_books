<!DOCTYPE html>
<html lang="ru">

<head>
    <%- include('partials/header', { title: 'Управление пользователями' }) %>
        <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <%- include('partials/navbar', { activeLink: 'admin' , authButtons: false }) %>

        <div class="page-container">
            <h1>Статистика покупок</h1>
            <div class="card">


                <div class="stats-grid" id="stats-container">
                    <!-- Данные будут загружены через JS -->
                </div>

                <!-- Фильтры -->
                <div class="search-container" style="margin-top: 20px;">
                    <input type="date" id="start-date">
                    <span style="margin: 0 10px;">—</span>
                    <input type="date" id="end-date">
                    <button id="reset-filter" class="btn outline">Сбросить</button>
                    <button id="search-button-stats" class="btn primary">Поиск</button>
                </div>

                <!-- Таблица покупок -->
                <div class="table" id="stats-table" style="margin-top: 20px;">
                    <table class="w-100">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Книга</th>
                                <th>Пользователь</th>
                                <th>Сумма</th>
                                <th>Дата</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody id="purchases-table-body">
                            <!-- Данные будут загружены через JS -->
                        </tbody>
                    </table>
                </div>
                <div id="no-stats" class="no-data-message">
                    <i class="fas fa-shopping-bag"></i>
                    <p>Покупки не найдены</p>
                </div>
            </div>

            <h1>Управление пользователями</h1>

            <div class="card">
                <!-- Поиск пользователей -->
                <div class="search-container">
                    <input type="text" id="user-search" placeholder="Поиск пользователей...">
                    <button id="search-button" class="btn primary">Поиск</button>
                </div>

                <!-- Кнопки для супер-админа -->
                <div id="super-admin-buttons" class="admin-actions" style="display: none;">
                    <button id="add-role-btn" class="btn primary">Добавить роль</button>
                </div>

                <div class="table">
                    <table class="w-100">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Имя</th>
                                <th>Email</th>
                                <th>Роли</th>
                                <th>Дата добавления</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody id="admins-table-body">
                            <!-- Список будет загружен через JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <h1>Управление ролями</h1>

            <div class="card">
                <div class="table">
                    <table class="w-100">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Название</th>
                                <th>Описание</th>
                                <th>Количество пользователей</th>
                                <th>Дата создания</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody id="roles-table-body">
                            <!-- Список ролей будет загружен через JS -->
                        </tbody>
                    </table>
                </div>
                <div id="no-roles" class="no-data-message" style="display: none;">
                    <i class="fas fa-user-tag"></i>
                    <p>Роли не найдены</p>
                </div>
            </div>


            <!-- Модальное окно добавления роли -->
            <div id="add-role-modal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h2>Добавить роль</h2>
                    <form id="add-role-form">
                        <div class="form-group">
                            <label for="role-name">Название роли*</label>
                            <input type="text" id="role-name" required>
                        </div>
                        <div class="form-group">
                            <label for="role-description">Описание</label>
                            <textarea id="role-description"></textarea>
                        </div>
                        <button type="submit" class="btn primary">Добавить</button>
                    </form>
                </div>
            </div>

            <!-- Модальное окно добавления роли пользователю -->
            <div id="add-user-role-modal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h2>Добавить роль пользователю</h2>
                    <form id="add-user-role-form">
                        <input type="hidden" id="target-user-id">
                        <div class="form-group">
                            <label for="user-role-select">Роль*</label>
                            <select id="user-role-select" required>
                                <!-- Роли будут загружены через JS -->
                            </select>
                        </div>
                        <button type="submit" class="btn primary">Добавить</button>
                    </form>
                </div>
            </div>

            <!-- Модальное окно удаления роли пользователя -->
            <div id="delete-user-role-modal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h2>Удалить роль пользователя</h2>
                    <form id="delete-user-role-form">
                        <input type="hidden" id="delete-target-user-id">
                        <div class="form-group">
                            <label for="delete-user-role-select">Роль*</label>
                            <select id="delete-user-role-select" required>
                                <!-- Роли будут загружены через JS -->
                            </select>
                        </div>
                        <button type="submit" class="btn danger">Удалить</button>
                    </form>
                </div>
            </div>

            <!-- Модальное окно редактирования роли -->
            <div id="edit-role-modal" class="modal">
                <div class="modal-content">
                    <h2>Редактировать роль</h2>
                    <form id="edit-role-form">
                        <input type="hidden" id="edit-role-id">
                        <div class="form-group">
                            <label for="edit-role-name">Название роли*</label>
                            <input type="text" id="edit-role-name" required>
                        </div>
                        <div class="form-group">
                            <label for="edit-role-description">Описание</label>
                            <textarea id="edit-role-description"></textarea>
                        </div>
                        <div class="form-footer" style="display: flex; gap: 10px; margin-top: 20px;">
                            <button type="button" class="btn outline close-edit-modal">Отмена</button>
                            <button type="submit" class="btn primary">Сохранить изменения</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
            <script src="/js/admin.js" type="module"></script>
</body>

</html>