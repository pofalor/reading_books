<!DOCTYPE html>
<html lang="ru">

<head>
    <%- include('partials/header.ejs', { title: `Книжная полка - ${book.title}` }) %>
    <link rel="stylesheet" href="/css/book.css">
</head>

<body>
    <%- include('partials/navbar', { activeLink: 'none', authButtons: !locals.user, user: locals.user }) %>

    <div class="page-container" data-book='<%- JSON.stringify(book) %>' 
        data-user='<%- JSON.stringify(locals.user) %>'>
        <div class="book-header">
            <div class="book-cover">
                <img src="<%= book.coverUrl || '/images/default-book.jpg' %>" alt="<%= book.title %>">
            </div>
            <div class="book-info">
                <h1><%= book.title %></h1>
                <p class="book-author">
                    Автор: <%= book.Author?.getAuthorName() || 'Неизвестен' %>
                </p>
                
                <% if (book.publicationYear) { %>
                    <p class="book-publication">
                        Год публикации: 
                        <%= book.formattedPublicationDate %>
                    </p>
                <% } %>

                <% if (book.price) { %>
                    <p class="book-price"><%= book.price.toFixed(2) %> ₽</p>
                <% } %>

                <div class="book-genres">
                    <% if (book.Genres && book.Genres.length > 0) { %>
                        <% book.Genres.forEach(genre => { %>
                            <span class="list-badge"><%= genre.name %></span>
                        <% }) %>
                    <% } else { %>
                        <span class="list-badge">Жанр не указан</span>
                    <% } %>
                </div>

                <div class="book-actions">
                    <button class="btn primary" id="read-btn">Читать</button>
                    <% if (book.price && book.price > 0) { %>
                        <a href="/purchase/<%= book.id %>" class="btn accent" id="buy-btn">Купить за <%= book.price.toFixed(2) %> ₽</a>
                    <% } %>
                    <button class="btn outline" id="shelf-btn">
                        <%= (book?.UserBook?.status === 'InProgress' || book?.UserBook?.status === 'OnShelf') ? 
                        'Убрать с полки' : 'На полку' %>
                    </button>
                </div>
            </div>
        </div>

        <div class="book-content">
            <% if (book.description) { %>
                <div class="book-description">
                    <h2>Описание</h2>
                    <p><%= book.description %></p>
                </div>
            <% } %>

            <div class="book-author-info">
                <h2>Об авторе</h2>
                <% if (book.Author) { %>
                    <p><%= book.Author.bio || 'Информация об авторе отсутствует.' %></p>
                <% } else { %>
                    <p>Автор не указан.</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Модалка авторизации -->
    <div id="auth-modal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Доступ ограничен</h2>
            <p id="modal-message"></p>
            <div class="modal-actions">
                <a href="/auth/login" class="btn primary">Войти</a>
                <a href="/auth/register" class="btn outline">Регистрация</a>
                <% if (book.price && book.price > 0) { %>
                    <a href="/purchase/<%= book.id %>" class="btn accent">Купить книгу</a>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script type="module" src="/js/book.js"></script>
</body>

</html>