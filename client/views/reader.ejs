<!DOCTYPE html>
<html lang="ru">
<head>
    <%- include('partials/header.ejs', { title: `Чтение - ${book.title}` }) %>
    <link rel="stylesheet" href="/css/reader.css">
</head>
<body class="<%= _locals.user ? 'logged-in' : '' %>">
    <%- include('partials/navbar',  { activeLink: 'none', authButtons: !_locals.user, user: _locals.user }) %>
    
    <div class="reader-container">
        <aside class="reader-sidebar">
            <div class="sidebar-header">
                <h3><%= book.title %></h3>
            </div>
            
            <div class="book-meta">
                <p>Автор: <%= book.Author?.getAuthorName() || 'Неизвестен' %></p>
            </div>
            
            <div class="toc-container">
                <h4>Оглавление</h4>
                <ul class="toc-list">
                    <% spine.contents.forEach((item, index) => { %>
                        <li>
                            <a href="#<%= item.id %>" class="toc-item">
                                <%= toc.find(t => t.id === item.id)?.label || `Глава ${index + 1}` %>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </aside>
        
        <main class="reader-content">
            <div id="book-content" class="book-content">
                <% bookContent.forEach(item => { %>
                    <section id="<%= item.id %>" class="book-chapter">
                        <%- item.content %>
                    </section>
                    <hr class="chapter-divider">
                <% }) %>
            </div>
        </main>
    </div>
    
    <script src="/js/reader.js" type="module"></script>
</body>
</html>