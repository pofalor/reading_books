# Шаблон переменных окружения.
# Скопируйте в .env и заполните своими значениями: cp .env.example .env
# Сам .env в репозиторий не попадает — он в .gitignore.

# Подключение к MySQL.
# При запуске через docker compose DB_HOST и DB_USER подставляются
# автоматически (база доступна по имени сервиса db), а DB_PASSWORD
# становится паролем root в контейнере MySQL.
DB_HOST=localhost
DB_NAME=book_app_db
DB_USER=root
DB_PASSWORD=change_me

# Секрет для подписи JWT.
# Сгенерировать случайное значение: openssl rand -hex 32
JWT_SECRET=change_me

# Каталог для загружаемых книг, относительно корня проекта
BOOK_UPLOAD_PATH=uploads/books

# Порт HTTP-сервера при локальном запуске (необязательно, по умолчанию 3000)
PORT=3000

# Порт хоста, на котором приложение публикуется из docker compose.
# Меняйте, если 3000 уже занят другим сервисом.
APP_PORT=3000
